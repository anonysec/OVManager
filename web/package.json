{
  "name": "frontend",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:types": "npx tsc --noEmit",
    "verify": "npm run build && npm run check:tokens && npm run check:i18n && npm run check:rtl && npx eslint src/ && npm run check:types && npx vitest run"
  },
  "dependencies": {
    "i18next": "^26.4.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.21",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
