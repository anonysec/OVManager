{
  "name": "frontend",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint -c .oxlintrc.json src e2e scripts",
    "preview": "vite preview",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:types": "tsc --noEmit",
    "verify": "npm run build && npm run check:tokens && npm run check:i18n && npm run check:rtl && npm run lint && npm run check:types && npx vitest run"
  },
  "dependencies": {
    "i18next": "^26.5.12",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "oxlint": "1.90.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
