# Admin Credentials
# Change these before first run — the installer generates strong defaults.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=***

# UVICORN Settings
HOST=0.0.0.0
URLPATH=dashboard
PORT=2095

### Ssl Configuration
# SSL_KEYFILE="/path/to/keyfile"
# SSL_CERTFILE="/path/to/certfile"

### Development Settings
# DEBUG=INFO
# DOC=True

### Security Settings
# JWT_SECRET_KEY — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY=***
# JWT_ACCESS_TOKEN_EXPIRES=86400 # in seconds

# SUBSCRIPTION_URL_PREFIX = "https://example.com"
# SUBSCRIPTION_PATH = "sub"