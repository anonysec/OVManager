# ═══════════════════════════════════════════════════════════════════
# Manual install? Read this first (installer users can ignore it):
# The installer writes a minimal .env (HOST, PORT, URLPATH=, ADMIN_USERNAME,
# DATA_DIR); it sets no secrets and no URL path prefix.
# If YOU copied this file by hand, set the owner credential before the
# first start (see "Owner credentials" below), and generate any secret with:
#   openssl rand -hex 32                                          # API-style key
# ═══════════════════════════════════════════════════════════════════
# ── Owner credentials ──────────────────────────────────────────────────
# The owner is an ordinary row in the panel database, NOT a .env variable
# (schema v16). ADMIN_USERNAME only says WHICH row is the owner.
ADMIN_USERNAME=admin
#
# ADMIN_PASSWORD is IGNORED — it is kept only so old .env files do not break,
# and any value here logs a warning at boot. To set the owner password:
#
#   installed:      sudo ovm reset-password --admin-pass '...'
#                   OVM_ADMIN_PASS='...' sudo ovm reset-password
#   manual install: ovm reset-password --admin-pass '...'
#
# For a MANUAL install you may instead put a bcrypt hash here and it is
# imported into the owner row on the first boot (and only then):
#   ADMIN_PASSWORD_HASH=$2b$12$...   # ovm reset-password --admin-pass '...'
# Leave both unset and create the owner with reset-password afterwards.
# ── Auth sessions ──────────────────────────────────────────────────────────
# The panel uses opaque database-backed sessions (no JWT since 1.7).
# Session tuning is optional — defaults shown:
#   SESSION_IDLE_SECONDS=1800     # log out after 30 min of inactivity
#   SESSION_MAX_SECONDS=604800    # absolute max lifetime: 7 days
# JWT_SECRET_KEY is DEPRECATED and ignored — safe to delete from your .env.

# ── Database backend (PasarGuard-style) ────────────────────────────────
# SQLite by default (single-process). To point at another backend later, set
# DATABASE_URL (aliases: SQLALCHEMY_DATABASE_URL, DB_URL). Only sqlite:/// is
# implemented today; postgres/mysql return a clear error until drivers are
# wired in internal/db/config.go.
#   DATABASE_URL=sqlite:///var/lib/ovmanager/ovmanager.db
#   DATABASE_URL=postgresql://user:pass@host:5432/ovmanager   # connection supported; migrations not yet ported
# DB_PATH=/var/lib/ovmanager/ovmanager.db   # explicit SQLite file (overrides DATA_DIR)
# POOL_SIZE=5   # database connection pool size (alias: DB_POOL_SIZE)

# ── Bind address ───────────────────────────────────────────────────────
# The address the panel listens on. 127.0.0.1 keeps a plaintext install on
# loopback (the installer writes exactly this). The container image sets
# 0.0.0.0, because a published port forwards to the container's own address.
HOST=127.0.0.1
# Aliases (PasarGuard-style): UVICORN_HOST, UVICORN_PORT
PORT=2095
# Secret path prefix hiding the panel from scanners (requests without it get
# a blank 404 page). The panel is never served at /: an empty value
# reverts to the default prefix "dashboard", it does not expose the panel
# at root. Forgot it? Run: ovm urlpath reset (or ovm urlpath show).
URLPATH=dashboard
# REQUIRED for shareable subscription links: your panel's public address,
# e.g. PUBLIC_URL=https://panel.example.com (defaults to localhost, which
# only works on the server itself).
# PUBLIC_URL=https://panel.example.com

# ── TLS (optional) ─────────────────────────────────────────────────────
# The panel serves HTTPS from the pair in tls_paths: .env declares it, else
# DATA_DIR/tls. Un-comment to force these paths over the DB record —
# the DB ssl_key_file / ssl_cert_file values are the UI record only.
# SSL_KEYFILE=/path/to/keyfile
# SSL_CERTFILE=/path/to/certfile

# ── Development ────────────────────────────────────────────────────────
# DEBUG=INFO
# DOC=True

# ── Secrets (no at-rest encryption since 1.0.5) ───────────────────────
# BOT_ENCRYPT_KEY / NODE_ENCRYPT_KEY / BACKUP_ENCRYPT_KEY are RETIRED
# no-ops — safe to delete from your .env. The server itself (owner login
# + 0600 database file) is the trust boundary; secrets live in the
# database as-is.

# ── Subscription links ─────────────────────────────────────────────────
# SUBSCRIPTION_URL_PREFIX=https://example.com
# SUBSCRIPTION_PATH=sub

# ── Performance tuning (optional) ──────────────────────────────────────
# How often the background collector polls the nodes. Lower feels more live
# in the UI; higher is gentler on the nodes and on CPU.
#   OVMANAGER_LIVE_POLL_SECONDS=10
#   OVM_TRAFFIC_POLL_SECONDS=60
#   OVM_METRICS_INTERVAL_SECONDS=300
# How often to poll when no browser has the live stream open. The snapshot
# still backs the public subscription page, so it must not go permanently
# stale, but there is no reason to probe every node for an audience of none.
#   OVMANAGER_LIVE_IDLE_POLL_SECONDS=300
#
# Redis is intentionally not used: the panel is a single process, so a broker
# would add latency, memory and another service to operate without a benefit.
# See "Performance notes" in README.md.

# ── Reverse proxy ──────────────────────────────────────────────────────
# Set this to true when OVManager sits behind a proxy you control (nginx,
# Caddy, Cloudflare). It does two things, and leaving it false behind a proxy
# has a consequence that is easy to miss:
#
#   true  — the client IP is read from X-Forwarded-For, so the login rate
#           limiter buckets per real visitor and the audit log records who
#           actually signed in.
#   false — every request appears to come from the proxy. The per-IP login
#           bucket (20 failures per window) is then shared by *all* users, so
#           twenty bad guesses under random usernames can lock out legitimate
#           logins for everyone, and audit rows record the proxy's address.
#
# Only enable it behind a proxy that overwrites X-Forwarded-For. With the
# panel exposed directly, a client could otherwise forge that header and
# defeat the rate limiter — which is why the default is false.
# TRUSTED_PROXY=false

# ── Advanced / CLI (usually set by the installer, not by hand) ────────
# OVM_APP_DIR=/opt/ovmanager        # where .env and frontend/ live
# DATA_DIR=/var/lib/ovmanager       # database + backups
# NODE_TLS_INSECURE_FALLBACK=false  # allow self-signed node TLS without a pin
# OVM_REPO=anonysec/OVManager      # release source for `ovm update`
# OVM_PANEL_USER=ovmanager         # OS user the service runs as
# OVM_ADMIN_PASS=                  # bootstrap password for `ovm reset-password`
# OVM_ACME_DOMAIN=                 # domain for built-in ACME issuance
# OVM_ACME_DIRECTORY_URL=          # override ACME directory (staging, etc.)
# OVM_ACME_HTTP_PORT=80            # HTTP-01 challenge port
