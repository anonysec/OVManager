# OVManager configuration. The installer writes this file with mode 0640
# (root:<panel-user>); edit it only for deliberate overrides.
#
# The owner is a row in the panel database, not a variable here.
# `OwnerUsername` only names that row before the first start.

# ── Bind / UI ──────────────────────────────────────────────────────────
Host=127.0.0.1
Port=2095
# Secret path prefix. Empty reverts to "dashboard"; the panel is never
# served at /.
BasePath=dashboard

# ── Data ───────────────────────────────────────────────────────────────
DataDir=/var/lib/ovmanager
# DbPath=/var/lib/ovmanager/app.db   # explicit file (overrides DataDir)
DbPoolSize=5

# ── TLS (direct; the panel terminates TLS itself) ──────────────────────
# Empty means DATA_DIR/tls/fullchain.pem and privkey.pem.
# TlsCertFile=/etc/letsencrypt/live/panel/fullchain.pem
# TlsKeyFile=/etc/letsencrypt/live/panel/privkey.pem

# ── ACME (panel certificate) ───────────────────────────────────────────
# The installer issues the first pair; the panel renews it automatically.
# AcmeHttpPort=80
# AcmeDirectoryUrl=              # staging/test directory override

# ── Secrets (optional; default DATA_DIR/secret.key) ────────────────────
# 64 hex characters: openssl rand -hex 32
# SecretKey=

# ── URLs / features ────────────────────────────────────────────────────
# Public address used for subscription links.
PublicUrl=
SubscriptionPath=sub
TrafficPollSeconds=10
ProbeTimeoutSeconds=5
# SESSION_TTL 7 days, idle 30 minutes.
SessionTtlSeconds=604800
SessionIdleSeconds=1800

# ── First-run owner bootstrap ──────────────────────────────────────────
OwnerUsername=admin
