# ── Admin credentials ──────────────────────────────────────────────────
# The installer generates strong random values; for manual installs set
# these before the first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run
# JWT signing key — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-random-32+char-secret

# ── Uvicorn ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=2095
URLPATH=dashboard
# Optional canonical public origin used for generated subscription/config links.
# PUBLIC_URL=https://panel.example.com

# ── TLS (optional) ─────────────────────────────────────────────────────
# SSL_KEYFILE=/path/to/keyfile
# SSL_CERTFILE=/path/to/certfile

# ── Development ────────────────────────────────────────────────────────
# DEBUG=INFO
# DOC=True

# ── Telegram bot ───────────────────────────────────────────────────────
# BOT_ENCRYPT_KEY — Fernet key for encrypting the bot token at rest.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Subscription links ─────────────────────────────────────────────────
# SUBSCRIPTION_URL_PREFIX=https://example.com
# SUBSCRIPTION_PATH=sub
