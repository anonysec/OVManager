# ═══════════════════════════════════════════════════════════════════
# Manual install? Read this first (installer users can ignore it):
# The installer writes this file for you with strong random secrets.
# If YOU copied this file by hand, you MUST change the 3 lines marked
# REQUIRED below before the first start — the app refuses to run with
# the placeholder password, and encryption keys have no default.
# Generate secrets with:
#   openssl rand -base64 18 | tr -d '/+=\n' | head -c 20; echo   # password
#   openssl rand -hex 32                                          # API-style key
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # Fernet
# ═══════════════════════════════════════════════════════════════════
# ── Admin credentials ──────────────────────────────────────────────────
ADMIN_USERNAME=admin
# REQUIRED: at least 12 characters, not containing "change-me".
ADMIN_PASSWORD=change-me-before-first-run
# ── Auth sessions ──────────────────────────────────────────────────────────
# The panel uses opaque database-backed sessions (no JWT since 1.7).
# Session tuning is optional — defaults shown:
#   SESSION_IDLE_SECONDS=1800     # log out after 30 min of inactivity
#   SESSION_MAX_SECONDS=604800    # absolute max lifetime: 7 days
# JWT_SECRET_KEY is DEPRECATED and ignored — safe to delete from your .env.

# ── Uvicorn ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=2095
# Secret path prefix hiding the panel from scanners (requests without it get
# an empty reply). The installer generates a random one; "dashboard" here is
# only an example. Empty it (URLPATH=) to serve at /. Forgot it? Run:
#   cd /opt/ovmanager && uv run main.py --reset-urlpath
URLPATH=dashboard
# REQUIRED for shareable subscription links: your panel's public address,
# e.g. PUBLIC_URL=https://panel.example.com (defaults to localhost, which
# only works on the server itself).
# PUBLIC_URL=https://panel.example.com

# ── TLS (optional) ─────────────────────────────────────────────────────
# SSL_KEYFILE=/path/to/keyfile
# SSL_CERTFILE=/path/to/certfile

# ── Development ────────────────────────────────────────────────────────
# DEBUG=INFO
# DOC=True

# ── Telegram bot ───────────────────────────────────────────────────────
# BOT_ENCRYPT_KEY — Fernet key for encrypting the bot token at rest.
# NODE_ENCRYPT_KEY — Fernet key for node API keys at rest (falls back to
# BOT_ENCRYPT_KEY when unset). REQUIRED for manual installs if you want
# secrets encrypted (without any key, tokens/keys sit in plaintext).
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Subscription links ─────────────────────────────────────────────────
# SUBSCRIPTION_URL_PREFIX=https://example.com
# SUBSCRIPTION_PATH=sub

# ── Performance tuning (optional) ──────────────────────────────────────
# How often the background collector polls the nodes. Lower feels more live
# in the UI; higher is gentler on the nodes and on CPU.
#   OVMANAGER_LIVE_POLL_SECONDS=10
# How often to poll when no browser has the live stream open. The snapshot
# still backs the public subscription page, so it must not go permanently
# stale, but there is no reason to probe every node for an audience of none.
#   OVMANAGER_LIVE_IDLE_POLL_SECONDS=300
#
# Redis is intentionally not used: the panel is a single process, so a broker
# would add latency, memory and another service to operate without a benefit.
# See "Performance notes" in README.md.

# ── Reverse proxy ──────────────────────────────────────────────────────
# Set to true only when OVManager sits behind a proxy you control, so
# X-Forwarded-Proto is trusted for HSTS.
# TRUSTED_PROXY=false
